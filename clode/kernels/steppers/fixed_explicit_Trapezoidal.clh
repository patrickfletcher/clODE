#include "realtype.cl"

//Explicit trapezoidal (Heun's method, improved Euler) time step
#define FIXED_STEPSIZE_EXPLICIT
static inline void do_step(
    const realtype tOrigin,
    realtype *elapsed,
    realtype *elapsedCorrection,
    realtype *stepEndTime,
    realtype xi[],
    realtype k1[],
    const realtype pars[],
    const realtype dt,
    realtype aux[],
    realtype wi[],
    __private struct rngData *rd
)
{
    (void)rd;

    realtype tEnd = compensatedTimeFromOriginAfterStep(
        tOrigin,
        *elapsed,
        *elapsedCorrection,
        dt
    );
    realtype tmp[N_VAR], k2[N_VAR];

    // On entry k1 is the slope at the current accepted state. On return it is
    // refreshed at the accepted endpoint for the next step.

    //compute k2: tmp[k]=xi[k]+dt*k1[k];  fma(dt, k1[k], xi[k]);
    for (int k = 0; k < N_VAR; k++)
        tmp[k] = fma(dt, k1[k], xi[k]);
    getRHS(tEnd, tmp, pars, k2, aux, wi);

    //update to new xi: average the above to get new xi
    for (int k = 0; k < N_VAR; k++)
        xi[k] += dt * RCONST(0.5) * (k1[k] + k2[k]);

    getRHS(tEnd, xi, pars, k1, aux, wi);
    compensatedTimeAdd(elapsed, elapsedCorrection, dt);
    *stepEndTime = tEnd;
}