#include "clODE_solver_status.cl"
#include "clODE_struct_defs.cl" //for IntegrationSettings struct definition
#include "realtype.cl"

// Wrapper for fixed-step explicit steppers. Fixed and adaptive steppers both
// advance solve-relative elapsed time with compensated accumulation and
// reconstruct stage times from t0 + elapsed. The wrapper returns a status flag
// and reports the accepted step width explicitly so solver consumers never need
// to recover it by differencing large elapsed totals.
static inline int stepper(
    realtype *ti,
    realtype *solveElapsed,
    realtype *solveElapsedCorrection,
    realtype xi[],
    realtype k1[],
    const realtype pars[],
    __constant struct IntegrationSettings *settings,
    realtype *dt,
    realtype *acceptedDt,
    __constant realtype *tspan,
    realtype aux[],
    realtype wi[],
    __private struct rngData *rd
)
{
    (void)settings;
    realtype stepDt = *dt;
    *acceptedDt = stepDt;

    realtype stepEndTime = compensatedTimeFromOriginAfterStep(
        tspan[0],
        *solveElapsed,
        *solveElapsedCorrection,
        stepDt
    );
    if (stepDt > ZERO && stepEndTime == *ti)
    {
        *acceptedDt = ZERO;
        return SOLVE_STATUS_NO_PROGRESS;
    }

    // The concrete fixed-step method owns its stage times, compensated
    // endpoint advance, endpoint slope refresh, and any step-local stochastic
    // bookkeeping. Fixed-step has no controller state, so dt is also the
    // accepted step width for this call.
    do_step(
        tspan[0],
        solveElapsed,
        solveElapsedCorrection,
        ti,
        xi,
        k1,
        pars,
        stepDt,
        aux,
        wi,
        rd
    );

    return 0;
}