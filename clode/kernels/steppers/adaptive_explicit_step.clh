#include "clODE_struct_defs.cl" //for IntegrationSettings struct definition
#include "realtype.cl"

#define SAFETY_FACTOR RCONST(0.8)
// #define EXPON RCONST(1.0)/LOCAL_ERROR_ORDER  //controls error per step -> local error only; err~tol
#define EXPON RCONST(1.0)/(LOCAL_ERROR_ORDER+RCONST(1.0))  //controls error per unit step (err/dt~tol) -> global error proportional to tol (tolerance proportional) 

// Wrapper to handle step-size adaptation. wi should be zeros. The wrapper
// returns a status flag and reports the accepted step width separately from the
// next step size to try.
static inline int stepper(
    realtype *ti,
    realtype *solveElapsed,
    realtype *solveElapsedCorrection,
    realtype xi[],
    realtype k1[],
    const realtype pars[],
    __constant struct IntegrationSettings *settings,
    realtype *dt,
    realtype *acceptedDt,
    __constant realtype *tspan,
    realtype aux[],
    realtype wi[],
    __private struct rngData *rd
)
{
    (void)rd;
    realtype trialTime, normErr, err[N_VAR], trialXi[N_VAR], trialK1[N_VAR];

    realtype proposedDt = *dt;
    *acceptedDt = ZERO;
    realtype threshold = settings->abstol / settings->reltol;
    realtype acceptedTime = compensatedTimeFromOrigin(
        tspan[0],
        *solveElapsed,
        *solveElapsedCorrection
    );
    realtype hmin = RCONST(16.0) * fabs(fabs(nextafter(acceptedTime, RCONST(1.1)*tspan[1])) - acceptedTime); //matches Matlab: hmin=16*eps(t)
    realtype solveDuration = tspan[1] - tspan[0];

    bool noFailedSteps = true;
    while (true)
    {
        realtype trialElapsed = *solveElapsed;
        realtype trialElapsedCorrection = *solveElapsedCorrection;
        trialTime = acceptedTime;
        for (int j = 0; j < N_VAR; j++)
        {
            trialXi[j] = xi[j];
            trialK1[j] = k1[j];
        }

        proposedDt = clamp(proposedDt, hmin, settings->dtmax); //limiters
        realtype stepDt = do_step(
            tspan[0],
            &trialElapsed,
            &trialElapsedCorrection,
            &trialTime,
            trialXi,
            trialK1,
            pars,
            proposedDt,
            aux,
            err,
            wi
        );

        //Error estimation - elementwise
        for (int j = 0; j < N_VAR; j++)
            err[j] /= fmax( fmax( fabs(xi[j]), fabs(trialXi[j]) ) , threshold);
        
        normErr = norm_inf(err, N_VAR); //largest relative error among variables (most conservative)

        //shrink dt if too much error
        if (normErr > settings->reltol)
        {
            if (stepDt <= hmin)
            {
                *dt = hmin;
                *acceptedDt = ZERO;
                return -1;
            } //pass error signal back to main loop..

            //matches matlab (double precision):
            if (noFailedSteps)
            { //first failure: shrink proportional to error
                noFailedSteps = false;
                proposedDt = stepDt * fmax(ADAPTIVE_STEP_MAX_SHRINK, SAFETY_FACTOR*pow(settings->reltol / normErr, EXPON));
            }
            else
            { //repeated failed step: cut stepsize in half
                proposedDt = stepDt * RCONST(0.5);
            }
        }
        else
        {   //accept the step, update time and solution
            *solveElapsed = trialElapsed;
            *solveElapsedCorrection = trialElapsedCorrection;
            acceptedTime = trialTime;
            *acceptedDt = stepDt;
            break;
        }
    }

    //no failure this step => attempt to increase dt for next timestep
    if (noFailedSteps)
        proposedDt *= fmin(ADAPTIVE_STEP_MAX_GROW,  SAFETY_FACTOR*pow(settings->reltol / normErr, EXPON)); //matches matlab (double precision)

    realtype currentElapsed = compensatedTimeValue(*solveElapsed, *solveElapsedCorrection);
    realtype remaining = fmax(ZERO, solveDuration - currentElapsed);
    proposedDt = fmin(proposedDt, remaining); //hit the final time exactly
    proposedDt = clamp(proposedDt, hmin, settings->dtmax); //limiters

    //update the solution and dt
    *dt = proposedDt; //new step size to attempt on next step
    *ti = acceptedTime;
    for (int j = 0; j < N_VAR; j++)
    {
        xi[j] = trialXi[j];
        k1[j] = trialK1[j];
    }

    return 0;
}