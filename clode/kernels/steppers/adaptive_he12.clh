#include "realtype.cl"

#define ADAPTIVE_STEPSIZE_EXPLICIT
#define FSAL_STEP_PROPERTY
#define LOCAL_ERROR_ORDER RCONST(1.0)
#define ADAPTIVE_STEP_MAX_SHRINK RCONST(0.5)
#define ADAPTIVE_STEP_MAX_GROW RCONST(5.0)

static inline realtype do_step(
    const realtype tOrigin,
    realtype *elapsed,
    realtype *elapsedCorrection,
    realtype *ti,
    realtype xi[],
    realtype k1[],
    const realtype pars[],
    const realtype dt,
    realtype aux[],
    realtype err[],
    const realtype wi[]
)
{
    realtype tEnd = compensatedTimeFromOriginAfterStep(
        tOrigin,
        *elapsed,
        *elapsedCorrection,
        dt
    );
    realtype xtmp[N_VAR], k2[N_VAR];

    // On entry k1 is the slope at the current accepted state. On return it is
    // refreshed at the accepted endpoint for the next step.

    //compute k2: xtmp[k]=xi[k]+dt*k1[k];  fma(dt, k1[k], xi[k]);
    for (int k = 0; k < N_VAR; k++)
        xtmp[k] = xi[k] + dt*k1[k];  //Euler
    getRHS(tEnd, xtmp, pars, k2, aux, wi); //slope at the accepted endpoint

    //update to new xi
    for (int k = 0; k < N_VAR; k++)
        xi[k] = xi[k] + dt * RCONST(0.5) * (k1[k] + k2[k]); //average the above to get new xi

    //error estimate in each variable
    for (int k = 0; k < N_VAR; k++) 
        err[k] = dt * RCONST(0.5) * (-k1[k] + k2[k]);

        //err[k] = xi[k] - xtmp[k];
        // xi[k] = xtmp[k]; //use euler?
        // xi[k] += err[k]; //Richardson?

    getRHS(tEnd, xi, pars, k2, aux, wi); //redo k2 at actual new point - alt, don't do FSAL.
    for (int k = 0; k < N_VAR; k++) 
        k1[k] = k2[k];

    compensatedTimeAdd(elapsed, elapsedCorrection, dt);
    *ti = tEnd;
    return dt;
}