#include "realtype.cl"

//Explicit (Forward) Euler
#define FIXED_STEPSIZE_EXPLICIT
#define STOCHASTIC_STEPPER
static inline void do_step(realtype xi[], realtype k1[], const realtype pars[], const realtype dt, const realtype tStart, const realtype tMid, const realtype tEnd, realtype aux[], realtype wi[])
{   
    (void)tStart;
    (void)tMid;
    (void)tEnd;

    //k1 passed in
    // getRHS(*ti, xi, pars, k1, aux, wi);
    
    //update to new ti, xi, k1
    for (int k = 0; k < N_VAR; k++)
        xi[k] = fma(dt, k1[k], xi[k]);

}