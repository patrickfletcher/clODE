#include "realtype.cl"

//Stochastic Explicit (Forward) Euler
#define FIXED_STEPSIZE_EXPLICIT
#define STOCHASTIC_STEPPER
static inline void do_step(
    const realtype tOrigin,
    realtype *elapsed,
    realtype *elapsedCorrection,
    realtype *ti,
    realtype xi[],
    realtype k1[],
    const realtype pars[],
    const realtype dt,
    realtype aux[],
    realtype wi[],
    __private struct rngData *rd
)
{
    realtype tEnd = compensatedTimeFromOriginAfterStep(
        tOrigin,
        *elapsed,
        *elapsedCorrection,
        dt
    );

    // On entry k1 is the slope at the current accepted state. On return it is
    // refreshed at the accepted endpoint for the next step.
    for (int k = 0; k < N_VAR; k++)
        xi[k] = fma(dt, k1[k], xi[k]);

    // this is the only stochastic stepper for now - it owns the Wiener variable update
    for (int j = 0; j < N_WIENER; ++j)
        wi[j] = randn(rd) / sqrt(dt);

    getRHS(tEnd, xi, pars, k1, aux, wi);
    compensatedTimeAdd(elapsed, elapsedCorrection, dt);
    *ti = tEnd;

}