#include "realtype.cl"

//Explicit Runge-Kutta 4 time step
#define FIXED_STEPSIZE_EXPLICIT
static inline void do_step(
    const realtype tOrigin,
    realtype *elapsed,
    realtype *elapsedCorrection,
    realtype *stepEndTime,
    realtype xi[],
    realtype k1[],
    const realtype pars[],
    const realtype dt,
    realtype aux[],
    realtype wi[],
    __private struct rngData *rd
)
{
    (void)rd;

    realtype tMid = compensatedTimeFromOriginAfterStep(
        tOrigin,
        *elapsed,
        *elapsedCorrection,
        RCONST(0.5) * dt
    );
    realtype tEnd = compensatedTimeFromOriginAfterStep(
        tOrigin,
        *elapsed,
        *elapsedCorrection,
        dt
    );
    realtype tmp[N_VAR], k2[N_VAR], k3[N_VAR], k4[N_VAR];

    // On entry k1 is the slope at the current accepted state. On return it is
    // refreshed at the accepted endpoint for the next step.
    for (int k = 0; k < N_VAR; k++)
        tmp[k] = xi[k] + RCONST(0.5) * dt * k1[k];
    getRHS(tMid, tmp, pars, k2, aux, wi);

    for (int k = 0; k < N_VAR; k++)
        tmp[k] = xi[k] + RCONST(0.5) * dt * k2[k]; 
    getRHS(tMid, tmp, pars, k3, aux, wi);

    for (int k = 0; k < N_VAR; k++)
        tmp[k] = xi[k] + dt*k3[k]; 
    getRHS(tEnd, tmp, pars, k4, aux, wi);

    for (int k = 0; k < N_VAR; k++)
        xi[k] += dt * (k1[k] + RCONST(2.0) * k2[k] + RCONST(2.0) * k3[k] + k4[k]) / RCONST(6.0);

    getRHS(tEnd, xi, pars, k1, aux, wi);
    compensatedTimeAdd(elapsed, elapsedCorrection, dt);
    *stepEndTime = tEnd;
}