#ifndef OBSERVER_NEIGHBORHOOD_2_H
#define OBSERVER_NEIGHBORHOOD_2_H

#ifdef USE_OBSERVER_NEIGHBORHOOD_2
#define TWO_PASS_EVENT_DETECTOR

struct ObserverState_nhood2
{
    realtype tbuffer[3];
    realtype xbuffer[3 * N_VAR];
    realtype dxbuffer[3 * N_VAR];

    realtype x0[N_VAR]; //center point of neighborhood for events
    realtype xTrajectoryMax[N_VAR];
    realtype xTrajectoryMin[N_VAR];
    realtype xTrajectoryMean[N_VAR];
    realtype xTrajectoryRange[N_VAR];
    realtype dxTrajectoryMax[N_VAR];
    realtype dxTrajectoryMin[N_VAR];

    realtype auxTrajectoryMax[N_AUX];
    realtype auxTrajectoryMin[N_AUX];
    realtype auxTrajectoryMean[N_AUX];
    
    realtype tExitNhood[N_STORE_EVENTS];

    //period-wise features
    realtype nMaxima[3]; //max/min/mean
    realtype period[3]; 

    realtype elapsedTotal;
    realtype lastStepDt;
    realtype tLastEvent;
    realtype elapsedLastEvent;
    realtype xThreshold;

    unsigned int thisNMaxima;
    unsigned int foundX0;
    unsigned int eventcount;
    unsigned int stepcount;

};

typedef struct ObserverState_nhood2 ObserverState;

static inline realtype neighborhood2NormSqAtSample(const ObserverState *od, const int sampleIndex) {
    realtype normSq = ZERO;
    for (int j = 0; j < N_VAR; ++j) {
        realtype range = od->xTrajectoryRange[j];
        if (range > ZERO) {
            realtype normalizedDiff = (od->xbuffer[j * 3 + sampleIndex] - od->x0[j]) / range;
            normSq += normalizedDiff * normalizedDiff;
        }
    }
    return normSq;
}

static inline realtype neighborhood2ExitFraction(
    const ObserverState *od,
    __constant struct ObserverRuntimeSettings *op
) {
    realtype a = ZERO;
    realtype b = ZERO;
    realtype c = -op->nHoodRadius * op->nHoodRadius;
    for (int j = 0; j < N_VAR; ++j) {
        realtype range = od->xTrajectoryRange[j];
        if (range <= ZERO)
            continue;

        realtype normalizedStart = (od->xbuffer[j * 3 + 1] - od->x0[j]) / range;
        realtype normalizedDelta = (od->xbuffer[j * 3 + 2] - od->xbuffer[j * 3 + 1]) / range;
        a += normalizedDelta * normalizedDelta;
        b += RCONST(2.0) * normalizedStart * normalizedDelta;
        c += normalizedStart * normalizedStart;
    }

    realtype alpha = ONE;
    if (a > UNIT_ROUNDOFF)
    {
        realtype discriminant = fmax(b * b - RCONST(4.0) * a * c, ZERO);
        alpha = (-b + sqrt(discriminant)) / (RCONST(2.0) * a);
    }
    else if (fabs(b) > UNIT_ROUNDOFF)
    {
        alpha = -c / b;
    }

    return clamp(alpha, ZERO, ONE);
}

//set initial values to relevant fields in ObserverState
static inline void initializeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {

    //put x0 in the leading position of the solution buffer
    od->tbuffer[2] = *ti;
    for (int j = 0; j < N_VAR; ++j) {
        od->xbuffer[j * 3 + 2] = xi[j];
        od->dxbuffer[j * 3 + 2] = dxi[j];
    }

    for (int j = 0; j < N_VAR; ++j) {
        od->x0[j] = xi[j];
        od->xTrajectoryMax[j] = -BIG_REAL;
        od->xTrajectoryMin[j] = BIG_REAL;
        od->xTrajectoryMean[j] = ZERO; 
        od->xTrajectoryRange[j] = ZERO; 
        od->dxTrajectoryMax[j] = -BIG_REAL;
        od->dxTrajectoryMin[j] = BIG_REAL;
    }
    for (int j = 0; j < N_AUX; ++j) {
        od->auxTrajectoryMax[j] = -BIG_REAL;
        od->auxTrajectoryMin[j] = BIG_REAL;
        od->auxTrajectoryMean[j] = ZERO;
    }
	for (int j = 0; j < N_STORE_EVENTS; ++j)
        od->tExitNhood[j] = ZERO;

    od->nMaxima[0] = -BIG_REAL;
    od->nMaxima[1] = BIG_REAL;
    od->nMaxima[2] = ZERO;

    od->period[0] = -BIG_REAL;
    od->period[1] = BIG_REAL;
    od->period[2] = ZERO;

    od->elapsedTotal = ZERO;
    od->lastStepDt = ZERO;
    od->tLastEvent=ZERO;
    od->elapsedLastEvent=ZERO;

    od->xThreshold = ZERO;

    od->thisNMaxima = 0;
    od->foundX0 = 0;
    od->eventcount = 0;
    od->stepcount = 0;
}

//restricted per-timestep update of observer state for initializing event detector
// - get extent of trajectory in state space, and max/min slopes
static inline void warmupObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    for (int j = 0; j < N_VAR; ++j) {
        od->xTrajectoryMax[j] = fmax(xi[j], od->xTrajectoryMax[j]);
        od->xTrajectoryMin[j] = fmin(xi[j], od->xTrajectoryMin[j]);
    }
}

//process warmup data to compute relevant event detector quantities (e.g. thresholds)
static inline void initializeEventDetector(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    for (int j = 0; j < N_VAR; ++j)
        od->xTrajectoryRange[j] = od->xTrajectoryMax[j] - od->xTrajectoryMin[j];
    od->xThreshold = od->xTrajectoryMin[op->eVarIx] + op->xDownThresh * od->xTrajectoryRange[op->eVarIx]; 
}

//check for exit from "epsilon ball" surrounding od->x0
static inline bool eventFunction(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;

    if (od->stepcount < 2 || !od->foundX0)
        return false;

    realtype radiusSq = op->nHoodRadius * op->nHoodRadius;
    realtype previousNormSq = neighborhood2NormSqAtSample(od, 1);
    realtype currentNormSq = neighborhood2NormSqAtSample(od, 2);
    return previousNormSq < radiusSq && currentNormSq >= radiusSq;
}

//When an event is detected, computes desired event-based features. returns true if a terminal event was reached
static inline bool computeEventFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;

    ++od->eventcount;
    
    realtype alpha = neighborhood2ExitFraction(od, op);
    realtype tThisEvent = od->tbuffer[1] + alpha * (od->tbuffer[2] - od->tbuffer[1]);
    realtype elapsedThisEvent = od->elapsedTotal - (ONE - alpha) * od->lastStepDt;

    if (od->eventcount > 1) { 
        od->nMaxima[0] = fmax((realtype)od->thisNMaxima, od->nMaxima[0]); //cast to realtype (for mean)
        od->nMaxima[1] = fmin((realtype)od->thisNMaxima, od->nMaxima[1]);
        runningMean(&od->nMaxima[2], (realtype)od->thisNMaxima, od->eventcount - 1);

        realtype thisPeriod = elapsedThisEvent - od->elapsedLastEvent;
        od->period[0] = fmax(thisPeriod, od->period[0]);
        od->period[1] = fmin(thisPeriod, od->period[1]);
        runningMean(&od->period[2], thisPeriod, od->eventcount - 1);
    }

    od->tLastEvent = tThisEvent;
    od->elapsedLastEvent = elapsedThisEvent;
    od->thisNMaxima = 0;

	if (od->eventcount <= N_STORE_EVENTS)
        od->tExitNhood[od->eventcount-1] = tThisEvent;

    if (od->eventcount == op->maxEventCount){
        return true;
    }
    return false; //not terminal
}

//full per-timestep update of observer state. If an event occurred this timestep, event-based observer state is reset. Per-timestep features are computed here.
static inline void updateObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], const realtype stepDt, ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    ++od->stepcount;
    od->elapsedTotal += stepDt;   //TODO: should this use compensated time??
    od->lastStepDt = stepDt;

    // advance solution buffer
    advanceAcceptedStepHistory3(od->tbuffer, *ti);
    advanceAcceptedStepHistory3ByVariable(od->xbuffer, xi, N_VAR);
    advanceAcceptedStepHistory3ByVariable(od->dxbuffer, dxi, N_VAR);

    //global extent of all vars, var slopes, and aux vars
    for (int j = 0; j < N_VAR; ++j) {
        od->xTrajectoryMax[j] = fmax(xi[j], od->xTrajectoryMax[j]);
        od->xTrajectoryMin[j] = fmin(xi[j], od->xTrajectoryMin[j]);
        od->xTrajectoryMean[j] = runningMeanTime(od->xTrajectoryMean[j], xi[j], stepDt, od->elapsedTotal);
        od->dxTrajectoryMax[j] = fmax(dxi[j], od->dxTrajectoryMax[j]);
        od->dxTrajectoryMin[j] = fmin(dxi[j], od->dxTrajectoryMin[j]);
    }
    for (int j = 0; j < N_AUX; ++j) {
        od->auxTrajectoryMax[j] = fmax(auxi[j], od->auxTrajectoryMax[j]);
        od->auxTrajectoryMin[j] = fmin(auxi[j], od->auxTrajectoryMin[j]);
        od->auxTrajectoryMean[j] = runningMeanTime(od->auxTrajectoryMean[j], auxi[j], stepDt, od->elapsedTotal);
    }

    if (od->stepcount < 2)
        return;

    if (od->foundX0) {
        //local max check in fVarIx
        if (od->dxbuffer[op->fVarIx * 3 + 1] >= 0.0 && od->dxbuffer[op->fVarIx * 3 + 2] < 0.0) {
            od->thisNMaxima++;
        }
        return;
    }

    // getting here means we still need to determine nhood center point x0
    // - define x0 as first time dropping below threshold in x[eVarIx]
    if (od->xbuffer[op->eVarIx * 3 + 1] > od->xThreshold && od->xbuffer[op->eVarIx * 3 + 2] < od->xThreshold) {
        od->foundX0 = 1;
        //record x0
        for (int j = 0; j < N_VAR; ++j)
            od->x0[j] = xi[j];
    }

}

//Perform and post-integration cleanup and write desired features into the global array F
static inline void finalizeFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __global realtype *F, int i, int nPts) {
    int ix = 0;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->period[0] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->period[1] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->period[2] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->nMaxima[0] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->nMaxima[1] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->nMaxima[2] : ZERO;
    for (int j = 0; j < N_VAR; ++j) //5*N_VAR
    {
        F[ix++ * nPts + i] = od->xTrajectoryMax[j];
        F[ix++ * nPts + i] = od->xTrajectoryMin[j];
        F[ix++ * nPts + i] = od->xTrajectoryMean[j];
        F[ix++ * nPts + i] = od->xTrajectoryRange[j];
        F[ix++ * nPts + i] = od->x0[j];
        F[ix++ * nPts + i] = od->dxTrajectoryMax[j];
        F[ix++ * nPts + i] = od->dxTrajectoryMin[j];
    }
    for (int j = 0; j < N_AUX; ++j) //3*N_AUX
    {
        F[ix++ * nPts + i] = od->auxTrajectoryMax[j];
        F[ix++ * nPts + i] = od->auxTrajectoryMin[j];
        F[ix++ * nPts + i] = od->auxTrajectoryMean[j];
    }
    for (int j = 0; j < N_STORE_EVENTS; ++j)
		F[ix++ * nPts + i] = od->tExitNhood[j];
    F[ix++ * nPts + i] = od->eventcount;
}

//Perform and post-integration cleanup of observer state to ensure it is ready for continuation if needed
static inline void finalizeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __constant realtype *tspan) {
}

#endif //USE_OBSERVER_NEIGHBORHOOD_2
#endif // OBSERVER_NEIGHBORHOOD_2_H
