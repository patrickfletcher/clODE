// Normalized neighborhood-return event detection with a warmup-derived state
// normalization and a lean return-timestamp-plus-count readout.

#ifndef OBSERVER_NEIGHBORHOOD_RETURN_H
#define OBSERVER_NEIGHBORHOOD_RETURN_H

#ifdef USE_OBSERVER_NEIGHBORHOOD_RETURN
#define TWO_PASS_EVENT_DETECTOR

struct ObserverState_neighborhood_return {
    realtype xbuffer[2];
    realtype x0[N_VAR];
    realtype xTrajectoryMax[N_VAR];
    realtype xTrajectoryMin[N_VAR];
    realtype xTrajectoryRange[N_VAR];
#if N_STORE_EVENTS > 0
    realtype tEventList[N_STORE_EVENTS];
#endif
    realtype xThreshold;
    unsigned int foundX0;
    unsigned int isInNhood;
    unsigned int eventcount;
    unsigned int stepcount;
};

typedef struct ObserverState_neighborhood_return ObserverState;

static inline void initializeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)dxi;
    (void)auxi;
    od->xbuffer[1] = xi[op->eVarIx];
    for (int j = 0; j < N_VAR; ++j) {
        od->x0[j] = xi[j];
        od->xTrajectoryMax[j] = -BIG_REAL;
        od->xTrajectoryMin[j] = BIG_REAL;
        od->xTrajectoryRange[j] = ZERO;
    }
#if N_STORE_EVENTS > 0
    for (int j = 0; j < N_STORE_EVENTS; ++j)
        od->tEventList[j] = ZERO;
#endif
    od->xThreshold = ZERO;
    od->foundX0 = 0;
    od->isInNhood = 0;
    od->eventcount = 0;
    od->stepcount = 0;
}

static inline void warmupObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)dxi;
    (void)auxi;
    (void)op;
    for (int j = 0; j < N_VAR; ++j) {
        od->xTrajectoryMax[j] = fmax(xi[j], od->xTrajectoryMax[j]);
        od->xTrajectoryMin[j] = fmin(xi[j], od->xTrajectoryMin[j]);
    }
}

static inline void initializeEventDetector(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;
    for (int j = 0; j < N_VAR; ++j)
        od->xTrajectoryRange[j] = od->xTrajectoryMax[j] - od->xTrajectoryMin[j];
    od->xThreshold = od->xTrajectoryMin[op->eVarIx] + op->xDownThresh * od->xTrajectoryRange[op->eVarIx];
}

static inline bool eventFunction(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)dxi;
    (void)auxi;

    if (od->stepcount < 1 || !od->foundX0)
        return false;

    realtype normSq = ZERO;
    for (int j = 0; j < N_VAR; ++j) {
        realtype range = od->xTrajectoryRange[j];
        if (range > ZERO) {
            realtype normalizedDiff = (xi[j] - od->x0[j]) / range;
            normSq += normalizedDiff * normalizedDiff;
        }
    }

    unsigned int lastInNhood = od->isInNhood;
    realtype radiusSq = op->nHoodRadius * op->nHoodRadius;
    od->isInNhood = normSq < radiusSq;
    return lastInNhood && !od->isInNhood;
}

static inline bool computeEventFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)xi;
    (void)dxi;
    (void)auxi;

    ++od->eventcount;
#if N_STORE_EVENTS > 0
    if (od->eventcount <= N_STORE_EVENTS)
        od->tEventList[od->eventcount - 1] = *ti;
#endif

    return od->eventcount == op->maxEventCount;
}

static inline void updateObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], const realtype stepDt, ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)dxi;
    (void)auxi;
    (void)stepDt;
    ++od->stepcount;
    od->xbuffer[0] = od->xbuffer[1];
    od->xbuffer[1] = xi[op->eVarIx];

    if (od->foundX0)
        return;

    if (od->xbuffer[0] > od->xThreshold && od->xbuffer[1] < od->xThreshold) {
        od->foundX0 = 1;
        od->isInNhood = 1;
        for (int j = 0; j < N_VAR; ++j)
            od->x0[j] = xi[j];
    }
}

static inline void finalizeFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __global realtype *F, int i, int nPts) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;
    (void)op;

    int ix = 0;
#if N_STORE_EVENTS > 0
    for (int j = 0; j < N_STORE_EVENTS; ++j)
        F[ix++ * nPts + i] = od->tEventList[j];
#endif
    F[ix++ * nPts + i] = (realtype)od->eventcount;
}

static inline void finalizeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __constant realtype *tspan) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;
    (void)od;
    (void)op;
    (void)tspan;
}

#endif // USE_OBSERVER_NEIGHBORHOOD_RETURN
#endif // OBSERVER_NEIGHBORHOOD_RETURN_H