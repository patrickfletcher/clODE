// Normalized neighborhood-return event detection with warmup-derived
// normalization and expanded trajectory/period/maxima readouts.

#ifndef OBSERVER_NORMALIZED_NEIGHBORHOOD_RETURN_H
#define OBSERVER_NORMALIZED_NEIGHBORHOOD_RETURN_H

#ifdef USE_OBSERVER_NORMALIZED_NEIGHBORHOOD_RETURN
#define TWO_PASS_EVENT_DETECTOR

struct ObserverState_normalized_neighborhood_return {
    realtype tStart;
    realtype elapsedbuffer[3];
    realtype xbuffer[3 * N_VAR];
    realtype dxbuffer[3 * N_VAR];
    realtype auxbuffer[3 * N_AUX];

    realtype x0[N_VAR];
    realtype xTrajectoryRange[N_VAR];

#if N_STORE_EVENTS > 0
    realtype tEventList[N_STORE_EVENTS];
    realtype xEventList[N_STORE_EVENTS * N_VAR];
    realtype auxEventList[N_STORE_EVENTS * N_AUX];
#endif

    // Trajectory statistics
    realtype xTrajectoryMax[N_VAR];
    realtype xTrajectoryMin[N_VAR];
    realtype xTrajectoryIntegral[N_VAR];
    realtype xTrajectoryIntegralCorrection[N_VAR];
    realtype dxTrajectoryMax[N_VAR];
    realtype dxTrajectoryMin[N_VAR];

    realtype auxTrajectoryMax[N_AUX];
    realtype auxTrajectoryMin[N_AUX];
    realtype auxTrajectoryIntegral[N_AUX];
    realtype auxTrajectoryIntegralCorrection[N_AUX];

    // Period and maxima count statistics
    realtype period[3];
    realtype nMaxima[3];
    realtype amplitude[3];

    realtype xGlobalMax;
    realtype xGlobalMin;
    realtype xWarmupMax;
    realtype xWarmupMin;
    realtype xThreshold;
    realtype elapsedAtChunkStart;
    realtype elapsedAtChunkStartCorrection;
    realtype elapsedLastEvent;
    realtype xLastMin;

    unsigned int foundX0;
    unsigned int thisNMaxima;
    unsigned int nAmplitude;
    unsigned int eventcount;
    unsigned int stepcount;
};

typedef struct ObserverState_normalized_neighborhood_return ObserverState;

static inline realtype neighborhoodReturnNormSqAtSample(const ObserverState *od, const int sampleIndex) {
    realtype normSq = ZERO;
    for (int j = 0; j < N_VAR; ++j) {
        realtype range = od->xTrajectoryRange[j];
        if (range > ZERO) {
            realtype normalizedDiff = (od->xbuffer[j * 3 + sampleIndex] - od->x0[j]) / range;
            normSq += normalizedDiff * normalizedDiff;
        }
    }
    return normSq;
}

static inline realtype neighborhoodReturnExitFraction(
    const ObserverState *od,
    __constant struct ObserverRuntimeSettings *op
) {
    realtype a = ZERO;
    realtype b = ZERO;
    realtype c = -op->nHoodRadius * op->nHoodRadius;
    for (int j = 0; j < N_VAR; ++j) {
        realtype range = od->xTrajectoryRange[j];
        if (range <= ZERO)
            continue;

        realtype normalizedStart = (od->xbuffer[j * 3 + 1] - od->x0[j]) / range;
        realtype normalizedDelta = (od->xbuffer[j * 3 + 2] - od->xbuffer[j * 3 + 1]) / range;
        a += normalizedDelta * normalizedDelta;
        b += RCONST(2.0) * normalizedStart * normalizedDelta;
        c += normalizedStart * normalizedStart;
    }

    realtype alpha = ONE;
    if (a > UNIT_ROUNDOFF) {
        realtype discriminant = fmax(b * b - RCONST(4.0) * a * c, ZERO);
        alpha = (-b + sqrt(discriminant)) / (RCONST(2.0) * a);
    } else if (fabs(b) > UNIT_ROUNDOFF) {
        alpha = -c / b;
    }

    return clamp(alpha, ZERO, ONE);
}

static inline void initializeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    od->tStart = *ti;
    od->elapsedbuffer[2] = ZERO;

    for (int j = 0; j < N_VAR; ++j) {
        od->xbuffer[j * 3 + 2] = xi[j];
        od->dxbuffer[j * 3 + 2] = dxi[j];
        od->x0[j] = xi[j];
        od->xTrajectoryRange[j] = ZERO;

        od->xTrajectoryMax[j] = -BIG_REAL;
        od->xTrajectoryMin[j] = BIG_REAL;
        od->xTrajectoryIntegral[j] = ZERO;
        od->xTrajectoryIntegralCorrection[j] = ZERO;
        od->dxTrajectoryMax[j] = -BIG_REAL;
        od->dxTrajectoryMin[j] = BIG_REAL;
    }
    for (int j = 0; j < N_AUX; ++j)
        od->auxbuffer[j * 3 + 2] = auxi[j];
    for (int j = 0; j < N_AUX; ++j) {
        od->auxTrajectoryMax[j] = -BIG_REAL;
        od->auxTrajectoryMin[j] = BIG_REAL;
        od->auxTrajectoryIntegral[j] = ZERO;
        od->auxTrajectoryIntegralCorrection[j] = ZERO;
    }

#if N_STORE_EVENTS > 0
    for (int j = 0; j < N_STORE_EVENTS; ++j) {
        od->tEventList[j] = ZERO;
        for (int k = 0; k < N_VAR; ++k)
            od->xEventList[j * N_VAR + k] = ZERO;
        for (int k = 0; k < N_AUX; ++k)
            od->auxEventList[j * N_AUX + k] = ZERO;
    }
#endif

    od->period[0] = -BIG_REAL;
    od->period[1] = BIG_REAL;
    od->period[2] = ZERO;

    od->nMaxima[0] = -BIG_REAL;
    od->nMaxima[1] = BIG_REAL;
    od->nMaxima[2] = ZERO;

    od->amplitude[0] = -BIG_REAL;
    od->amplitude[1] = BIG_REAL;
    od->amplitude[2] = ZERO;

    od->xGlobalMax = -BIG_REAL;
    od->xGlobalMin = BIG_REAL;
    od->xWarmupMax = -BIG_REAL;
    od->xWarmupMin = BIG_REAL;
    od->xThreshold = ZERO;
    od->elapsedAtChunkStart = ZERO;
    od->elapsedAtChunkStartCorrection = ZERO;
    od->elapsedLastEvent = ZERO;
    od->xLastMin = BIG_REAL;

    od->foundX0 = 0;
    od->thisNMaxima = 0;
    od->nAmplitude = 0;
    od->eventcount = 0;
    od->stepcount = 0;

    (void)op;
}

static inline void warmupObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)dxi;
    (void)auxi;
    od->xGlobalMax = fmax(od->xGlobalMax, xi[op->eVarIx]);
    od->xGlobalMin = fmin(od->xGlobalMin, xi[op->eVarIx]);
    od->xWarmupMax = fmax(od->xWarmupMax, xi[op->eVarIx]);
    od->xWarmupMin = fmin(od->xWarmupMin, xi[op->eVarIx]);

    for (int j = 0; j < N_VAR; ++j) {
        od->xTrajectoryMax[j] = fmax(xi[j], od->xTrajectoryMax[j]);
        od->xTrajectoryMin[j] = fmin(xi[j], od->xTrajectoryMin[j]);
    }
}

static inline void initializeEventDetector(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;

    for (int j = 0; j < N_VAR; ++j)
        od->xTrajectoryRange[j] = od->xTrajectoryMax[j] - od->xTrajectoryMin[j];

    od->xThreshold = od->xWarmupMin + op->xDownThresh * (od->xWarmupMax - od->xWarmupMin);
    od->foundX0 = 0;
    od->eventcount = 0;
    od->stepcount = 0;
    od->thisNMaxima = 0;
    od->elapsedAtChunkStart = ZERO;
    od->elapsedAtChunkStartCorrection = ZERO;

    od->tStart = *ti;
    od->elapsedbuffer[2] = ZERO;
    for (int j = 0; j < N_VAR; ++j) {
        od->xbuffer[j * 3 + 2] = xi[j];
        od->dxbuffer[j * 3 + 2] = dxi[j];
        od->x0[j] = xi[j];

        // Reset trajectory stats for observation window after warmup.
        od->xTrajectoryMax[j] = -BIG_REAL;
        od->xTrajectoryMin[j] = BIG_REAL;
        od->xTrajectoryIntegral[j] = ZERO;
        od->xTrajectoryIntegralCorrection[j] = ZERO;
        od->dxTrajectoryMax[j] = -BIG_REAL;
        od->dxTrajectoryMin[j] = BIG_REAL;
    }
    for (int j = 0; j < N_AUX; ++j)
        od->auxbuffer[j * 3 + 2] = auxi[j];
    for (int j = 0; j < N_AUX; ++j) {
        od->auxTrajectoryMax[j] = -BIG_REAL;
        od->auxTrajectoryMin[j] = BIG_REAL;
        od->auxTrajectoryIntegral[j] = ZERO;
        od->auxTrajectoryIntegralCorrection[j] = ZERO;
    }

#if N_STORE_EVENTS > 0
    for (int j = 0; j < N_STORE_EVENTS; ++j) {
        od->tEventList[j] = ZERO;
        for (int k = 0; k < N_VAR; ++k)
            od->xEventList[j * N_VAR + k] = ZERO;
        for (int k = 0; k < N_AUX; ++k)
            od->auxEventList[j * N_AUX + k] = ZERO;
    }
#endif

    od->period[0] = -BIG_REAL;
    od->period[1] = BIG_REAL;
    od->period[2] = ZERO;

    od->nMaxima[0] = -BIG_REAL;
    od->nMaxima[1] = BIG_REAL;
    od->nMaxima[2] = ZERO;

    od->amplitude[0] = -BIG_REAL;
    od->amplitude[1] = BIG_REAL;
    od->amplitude[2] = ZERO;

    od->elapsedLastEvent = ZERO;
    od->nAmplitude = 0;
}

static inline bool eventFunction(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;

    if (od->stepcount < 1 || !od->foundX0)
        return false;

    if (od->xGlobalMax - od->xGlobalMin < op->minXamp)
        return false;

    realtype radiusSq = op->nHoodRadius * op->nHoodRadius;
    realtype previousNormSq = neighborhoodReturnNormSqAtSample(od, 1);
    realtype currentNormSq = neighborhoodReturnNormSqAtSample(od, 2);
    return previousNormSq < radiusSq && currentNormSq >= radiusSq;
}

static inline bool computeEventFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;

    ++od->eventcount;
    realtype alpha = neighborhoodReturnExitFraction(od, op);
    realtype elapsedThisEvent = linearInterpByFraction(
        od->elapsedbuffer[1],
        od->elapsedbuffer[2],
        alpha
    );
    realtype tThisEvent = compensatedTimeFromOrigin(
        od->tStart,
        elapsedThisEvent,
        ZERO
    );

#if N_STORE_EVENTS > 0
    if (od->eventcount <= N_STORE_EVENTS) {
        const int eventIndex = od->eventcount - 1;
        od->tEventList[eventIndex] = tThisEvent;
        for (int j = 0; j < N_VAR; ++j) {
            od->xEventList[eventIndex * N_VAR + j] = linearInterpByFraction(
                od->xbuffer[j * 3 + 1],
                od->xbuffer[j * 3 + 2],
                alpha
            );
        }
        for (int j = 0; j < N_AUX; ++j) {
            od->auxEventList[eventIndex * N_AUX + j] = linearInterpByFraction(
                od->auxbuffer[j * 3 + 1],
                od->auxbuffer[j * 3 + 2],
                alpha
            );
        }
    }
#endif

    if (od->eventcount > 1) {
        int nPeriods = od->eventcount - 1;
        realtype thisPeriod = elapsedThisEvent - od->elapsedLastEvent;

        od->period[0] = fmax(thisPeriod, od->period[0]);
        od->period[1] = fmin(thisPeriod, od->period[1]);
        runningMean(&od->period[2], thisPeriod, nPeriods);

        od->nMaxima[0] = fmax((realtype)od->thisNMaxima, od->nMaxima[0]);
        od->nMaxima[1] = fmin((realtype)od->thisNMaxima, od->nMaxima[1]);
        runningMean(&od->nMaxima[2], (realtype)od->thisNMaxima, nPeriods);
    }

    od->elapsedLastEvent = elapsedThisEvent;
    od->thisNMaxima = 0;

    return od->eventcount == op->maxEventCount;
}

static inline void updateObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], const realtype stepDt, const realtype solveElapsedTotal, ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    ++od->stepcount;
    const realtype elapsedTotal = observerElapsedValue(
        od->elapsedAtChunkStart,
        od->elapsedAtChunkStartCorrection,
        solveElapsedTotal
    );

    advanceAcceptedStepHistory3(od->elapsedbuffer, elapsedTotal);
    advanceAcceptedStepHistory3ByVariable(od->xbuffer, xi, N_VAR);
    advanceAcceptedStepHistory3ByVariable(od->dxbuffer, dxi, N_VAR);
    advanceAcceptedStepHistory3ByVariable(od->auxbuffer, auxi, N_AUX);

    for (int j = 0; j < N_VAR; ++j) {
        od->xTrajectoryMax[j] = fmax(xi[j], od->xTrajectoryMax[j]);
        od->xTrajectoryMin[j] = fmin(xi[j], od->xTrajectoryMin[j]);
        compensatedIntegrateConstant(
            &od->xTrajectoryIntegral[j],
            &od->xTrajectoryIntegralCorrection[j],
            stepDt,
            xi[j]
        );
        od->dxTrajectoryMax[j] = fmax(dxi[j], od->dxTrajectoryMax[j]);
        od->dxTrajectoryMin[j] = fmin(dxi[j], od->dxTrajectoryMin[j]);
    }
    for (int j = 0; j < N_AUX; ++j) {
        od->auxTrajectoryMax[j] = fmax(auxi[j], od->auxTrajectoryMax[j]);
        od->auxTrajectoryMin[j] = fmin(auxi[j], od->auxTrajectoryMin[j]);
        compensatedIntegrateConstant(
            &od->auxTrajectoryIntegral[j],
            &od->auxTrajectoryIntegralCorrection[j],
            stepDt,
            auxi[j]
        );
    }

    od->xGlobalMax = fmax(od->xGlobalMax, xi[op->eVarIx]);
    od->xGlobalMin = fmin(od->xGlobalMin, xi[op->eVarIx]);

    if (!od->foundX0
        && od->xbuffer[op->eVarIx * 3 + 1] > od->xThreshold
        && od->xbuffer[op->eVarIx * 3 + 2] < od->xThreshold) {
        od->foundX0 = 1;
        for (int j = 0; j < N_VAR; ++j)
            od->x0[j] = od->xbuffer[j * 3 + 2];
    }

    if (od->stepcount < 2)
        return;

    if (od->dxbuffer[op->fVarIx * 3 + 1] > 0.0 && od->dxbuffer[op->fVarIx * 3 + 2] < 0.0) {
        realtype thisElapsedBuffer[3];
        realtype thisXbuffer[3];
        for (int j = 0; j < 3; ++j) {
            thisElapsedBuffer[j] = od->elapsedbuffer[j];
            thisXbuffer[j] = od->xbuffer[op->fVarIx * 3 + j];
        }
        realtype elapsedThisMax;
        realtype xThisMax;
        localMaximumFromThreeSamples(thisElapsedBuffer, thisXbuffer, &elapsedThisMax, &xThisMax);
        ++od->thisNMaxima;

        if (od->xLastMin < BIG_REAL) {
            realtype thisAmp = xThisMax - od->xLastMin;
            ++od->nAmplitude;
            od->amplitude[0] = fmax(thisAmp, od->amplitude[0]);
            od->amplitude[1] = fmin(thisAmp, od->amplitude[1]);
            runningMean(&od->amplitude[2], thisAmp, od->nAmplitude);
        }
    }

    if (od->dxbuffer[op->fVarIx * 3 + 1] < 0.0 && od->dxbuffer[op->fVarIx * 3 + 2] > 0.0) {
        realtype thisElapsedBuffer[3];
        realtype thisXbuffer[3];
        for (int j = 0; j < 3; ++j) {
            thisElapsedBuffer[j] = od->elapsedbuffer[j];
            thisXbuffer[j] = od->xbuffer[op->fVarIx * 3 + j];
        }
        realtype elapsedThisMin;
        localMinimumFromThreeSamples(thisElapsedBuffer, thisXbuffer, &elapsedThisMin, &od->xLastMin);
    }
}

static inline void finalizeFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, const realtype solveElapsedTotal, __global realtype *F, int i, int nPts) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;
    (void)op;

    const realtype elapsedTotal = observerElapsedValue(
        od->elapsedAtChunkStart,
        od->elapsedAtChunkStartCorrection,
        solveElapsedTotal
    );

    int ix = 0;
#if N_STORE_EVENTS > 0
    for (int j = 0; j < N_STORE_EVENTS; ++j) {
        F[ix++ * nPts + i] = od->tEventList[j];
        for (int k = 0; k < N_VAR; ++k)
            F[ix++ * nPts + i] = od->xEventList[j * N_VAR + k];
        for (int k = 0; k < N_AUX; ++k)
            F[ix++ * nPts + i] = od->auxEventList[j * N_AUX + k];
    }
#endif
    F[ix++ * nPts + i] = (realtype)od->eventcount;

    F[ix++ * nPts + i] = od->eventcount > 1 ? od->period[0] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->period[1] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->period[2] : ZERO;

    F[ix++ * nPts + i] = od->eventcount > 1 ? od->nMaxima[0] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->nMaxima[1] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->nMaxima[2] : ZERO;

    F[ix++ * nPts + i] = od->nAmplitude > 0 ? od->amplitude[0] : ZERO;
    F[ix++ * nPts + i] = od->nAmplitude > 0 ? od->amplitude[1] : ZERO;
    F[ix++ * nPts + i] = od->nAmplitude > 0 ? od->amplitude[2] : ZERO;

    for (int j = 0; j < N_VAR; ++j) {
        F[ix++ * nPts + i] = od->xTrajectoryMax[j];
        F[ix++ * nPts + i] = od->xTrajectoryMin[j];
        F[ix++ * nPts + i] = meanFromCompensatedIntegral(
            od->xTrajectoryIntegral[j],
            od->xTrajectoryIntegralCorrection[j],
            elapsedTotal
        );
        F[ix++ * nPts + i] = od->dxTrajectoryMax[j];
        F[ix++ * nPts + i] = od->dxTrajectoryMin[j];
        F[ix++ * nPts + i] = od->xTrajectoryRange[j];
        F[ix++ * nPts + i] = od->x0[j];
    }

    for (int j = 0; j < N_AUX; ++j) {
        F[ix++ * nPts + i] = od->auxTrajectoryMax[j];
        F[ix++ * nPts + i] = od->auxTrajectoryMin[j];
        F[ix++ * nPts + i] = meanFromCompensatedIntegral(
            od->auxTrajectoryIntegral[j],
            od->auxTrajectoryIntegralCorrection[j],
            elapsedTotal
        );
    }
}

static inline void finalizeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, const realtype solveElapsedTotal) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;
    (void)op;
    advanceObserverElapsedChunk(
        &od->elapsedAtChunkStart,
        &od->elapsedAtChunkStartCorrection,
        solveElapsedTotal
    );
}

#endif // USE_OBSERVER_NORMALIZED_NEIGHBORHOOD_RETURN
#endif // OBSERVER_NORMALIZED_NEIGHBORHOOD_RETURN_H
