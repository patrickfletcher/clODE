//Event is the detection of local max in specified variable fVarIx

#ifndef OBSERVER_LOCAL_MAX_H
#define OBSERVER_LOCAL_MAX_H

#ifdef USE_OBSERVER_LOCAL_MAX
//events are triggered at local maxima in the variable specified by op.fVarIx

struct ObserverState_localmax
{
    realtype tbuffer[3];
    realtype elapsedbuffer[3];
    realtype xbuffer[3 * N_VAR];
    realtype dxbuffer[3 * N_VAR];

    realtype xTrajectoryMax[N_VAR];
    realtype xTrajectoryMin[N_VAR];
    realtype xTrajectoryIntegral[N_VAR];
    realtype xTrajectoryIntegralCorrection[N_VAR];
    realtype dxTrajectoryMax[N_VAR];
    realtype dxTrajectoryMin[N_VAR];

    realtype auxTrajectoryMax[N_AUX];
    realtype auxTrajectoryMin[N_AUX];
    realtype auxTrajectoryIntegral[N_AUX];
    realtype auxTrajectoryIntegralCorrection[N_AUX];
    
    realtype IMI[3]; //max/min/mean
    realtype amplitude[3]; //max/min/mean

    realtype xGlobalMax;
    realtype xGlobalMin;
    realtype elapsedTotal;
    realtype elapsedTotalCorrection;
    realtype tLastMax;
    realtype elapsedLastMax;
    //realtype xLastMax;
    realtype tLastMin;
    realtype xLastMin;

    unsigned int eventcount;
    unsigned int stepcount;

    realtype tMaxList[N_STORE_EVENTS];
    realtype xMaxList[N_STORE_EVENTS];
    realtype tMinList[N_STORE_EVENTS];
    realtype xMinList[N_STORE_EVENTS];

};

typedef struct ObserverState_localmax ObserverState;

//set initial values to relevant fields in ObserverState
static inline void initializeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    od->tbuffer[2] = *ti;
    od->elapsedbuffer[2] = ZERO;
    for (int j = 0; j < N_VAR; ++j) {
        od->xbuffer[j * 3 + 2] = xi[j];
        od->dxbuffer[j * 3 + 2] = dxi[j];
    }

    for (int j = 0; j < N_VAR; ++j) {
        od->xTrajectoryMax[j] = -BIG_REAL;
        od->xTrajectoryMin[j] = BIG_REAL;
        od->xTrajectoryIntegral[j] = ZERO;
        od->xTrajectoryIntegralCorrection[j] = ZERO;
        od->dxTrajectoryMax[j] = -BIG_REAL;
        od->dxTrajectoryMin[j] = BIG_REAL;
    }
    for (int j = 0; j < N_AUX; ++j) {
        od->auxTrajectoryMax[j] = -BIG_REAL;
        od->auxTrajectoryMin[j] = BIG_REAL;
        od->auxTrajectoryIntegral[j] = ZERO;
        od->auxTrajectoryIntegralCorrection[j] = ZERO;
    }

    for (int j = 0; j < N_STORE_EVENTS; ++j) {
		od->tMaxList[j] = ZERO;
		od->xMaxList[j] = ZERO;
		od->tMinList[j] = ZERO;
		od->xMinList[j] = ZERO;
	}

    od->IMI[0] = -BIG_REAL;
    od->IMI[1] = BIG_REAL;
    od->IMI[2] = ZERO;

    od->amplitude[0] = -BIG_REAL;
    od->amplitude[1] = BIG_REAL;
    od->amplitude[2] = ZERO;

    od->xGlobalMax = xi[op->eVarIx];
    od->xGlobalMin = xi[op->eVarIx];
    od->elapsedTotal = ZERO;
    od->elapsedTotalCorrection = ZERO;
    od->tLastMax = ZERO;
    od->elapsedLastMax = ZERO;
    od->tLastMin = ZERO;
    od->xLastMin = BIG_REAL;

    od->eventcount = 0;
    od->stepcount = 0;
}

//no warmup needed
static inline void warmupObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
}

//process warmup data to compute relevant event detector quantities (e.g. thresholds)
static inline void initializeEventDetector(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
}

//check buffer of slopes for local max
static inline bool eventFunction(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {

    if (od->stepcount < 2)
        return false;

    if (od->xGlobalMax - od->xGlobalMin < op->minXamp)
        return false;

    // Event is a local maximum
    return (od->dxbuffer[op->fVarIx * 3 + 1] > 0.0 && od->dxbuffer[op->fVarIx * 3 + 2] < 0.0);
}

//When an event is detected, computes desired event-based features. returns true if a terminal event was reached
// - get (t,x) at local max, compute: IMI, tMaxMin, amp
static inline bool computeEventFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    
    // Refine the buffered extremum with the shared bounded quadratic helper.
    realtype thisTbuffer[3];
    realtype thisElapsedBuffer[3];
    realtype thisXbuffer[3];
    for (int j = 0; j < 3; ++j) {
	 	thisTbuffer[j] = od->tbuffer[j];
	 	thisElapsedBuffer[j] = od->elapsedbuffer[j];
	 	thisXbuffer[j] = od->xbuffer[op->fVarIx * 3 + j];
    }

    realtype tThisMax;
    realtype elapsedThisMax;
    realtype xThisMax;
    localMaximumFromThreeSamples(thisTbuffer, thisXbuffer, &tThisMax, &xThisMax);
    localMaximumFromThreeSamples(thisElapsedBuffer, thisXbuffer, &elapsedThisMax, &xThisMax);


    ++od->eventcount;

    if (od->eventcount > 1) { //implies tLastMax, tLastMin and xLastMin are set

        //max/min/mean IMI
        realtype thisIMI = elapsedThisMax - od->elapsedLastMax;
        od->IMI[0] = fmax(thisIMI, od->IMI[0]);
        od->IMI[1] = fmin(thisIMI, od->IMI[1]);
        runningMean(&od->IMI[2], thisIMI, od->eventcount - 1);

        //max/min/mean amplitude
        realtype thisAmplitude = xThisMax - od->xLastMin;
        od->amplitude[0] = fmax(thisAmplitude, od->amplitude[0]);
        od->amplitude[1] = fmin(thisAmplitude, od->amplitude[1]);
        runningMean(&od->amplitude[2], thisAmplitude, od->eventcount - 1);
    }

    //update stored "last" values
    od->tLastMax = tThisMax;
    od->elapsedLastMax = elapsedThisMax;
    // od->xLastMax = xThisMax;

	if (od->eventcount <= N_STORE_EVENTS){
        od->tMaxList[od->eventcount-1] = tThisMax;
        od->xMaxList[od->eventcount-1] = xThisMax;
    }

    return od->eventcount == op->maxEventCount;
}

//full per-timestep update of observer state. If an event occurred this timestep, event-based observer state is reset. Per-timestep features are computed here.
// - advance solution/slope buffers
// - check for any intermediate special points & store their info
// - reset intermediates upon local max event detection
static inline void updateObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], const realtype stepDt, ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    ++od->stepcount;
    compensatedIntegrateConstant(
        &od->elapsedTotal,
        &od->elapsedTotalCorrection,
        stepDt,
        ONE
    );
    const realtype elapsedTotal = compensatedSumValue(
        od->elapsedTotal,
        od->elapsedTotalCorrection
    );

    // advance solution buffer
    advanceAcceptedStepHistory3(od->tbuffer, *ti);
    advanceAcceptedStepHistory3(od->elapsedbuffer, elapsedTotal);
    advanceAcceptedStepHistory3ByVariable(od->xbuffer, xi, N_VAR);
    advanceAcceptedStepHistory3ByVariable(od->dxbuffer, dxi, N_VAR);

    //global extent of all vars, var slopes, and aux vars
    for (int j = 0; j < N_VAR; ++j) {
        od->xTrajectoryMax[j] = fmax(xi[j], od->xTrajectoryMax[j]);
        od->xTrajectoryMin[j] = fmin(xi[j], od->xTrajectoryMin[j]);
        compensatedIntegrateConstant(
            &od->xTrajectoryIntegral[j],
            &od->xTrajectoryIntegralCorrection[j],
            stepDt,
            xi[j]
        );
        od->dxTrajectoryMax[j] = fmax(dxi[j], od->dxTrajectoryMax[j]);
        od->dxTrajectoryMin[j] = fmin(dxi[j], od->dxTrajectoryMin[j]);
    }
    for (int j = 0; j < N_AUX; ++j) {
        od->auxTrajectoryMax[j] = fmax(auxi[j], od->auxTrajectoryMax[j]);
        od->auxTrajectoryMin[j] = fmin(auxi[j], od->auxTrajectoryMin[j]);
        compensatedIntegrateConstant(
            &od->auxTrajectoryIntegral[j],
            &od->auxTrajectoryIntegralCorrection[j],
            stepDt,
            auxi[j]
        );
    }

    od->xGlobalMax = fmax(od->xGlobalMax, xi[op->eVarIx]);
    od->xGlobalMin = fmin(od->xGlobalMin, xi[op->eVarIx]);

    if (od->stepcount < 2)
        return;

    //local min check
    if (od->dxbuffer[op->fVarIx * 3 + 1] < 0.0 && od->dxbuffer[op->fVarIx * 3 + 2] > 0.0) {
        realtype thisTbuffer[3];
        realtype thisXbuffer[3];
        for (int j = 0; j < 3; ++j) {
            thisTbuffer[j] = od->tbuffer[j];
            thisXbuffer[j] = od->xbuffer[op->fVarIx * 3 + j];
        }
        localMinimumFromThreeSamples(thisTbuffer, thisXbuffer, &od->tLastMin, &od->xLastMin);

        if (od->eventcount > 0 && od->eventcount <= N_STORE_EVENTS) {
            od->tMinList[od->eventcount-1] = od->tLastMin;
            od->xMinList[od->eventcount-1] = od->xLastMin;
        }
    }
}



//Perform and post-integration cleanup and write desired features into the global array F
static inline void finalizeFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __global realtype *F, int i, int nPts) {
    const realtype elapsedTotal = compensatedSumValue(
        od->elapsedTotal,
        od->elapsedTotalCorrection
    );

    int ix = 0;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->IMI[0] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->amplitude[0] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->amplitude[1] : ZERO;
    F[ix++ * nPts + i] = od->eventcount > 1 ? od->amplitude[2] : ZERO;
    for (int j = 0; j < N_VAR; ++j) {
        F[ix++ * nPts + i] = od->xTrajectoryMax[j];
        F[ix++ * nPts + i] = od->xTrajectoryMin[j];
        F[ix++ * nPts + i] = meanFromCompensatedIntegral(
            od->xTrajectoryIntegral[j],
            od->xTrajectoryIntegralCorrection[j],
            elapsedTotal
        );
        F[ix++ * nPts + i] = od->dxTrajectoryMax[j];
        F[ix++ * nPts + i] = od->dxTrajectoryMin[j];
    }
    for (int j = 0; j < N_AUX; ++j) {
        F[ix++ * nPts + i] = od->auxTrajectoryMax[j];
        F[ix++ * nPts + i] = od->auxTrajectoryMin[j];
        F[ix++ * nPts + i] = meanFromCompensatedIntegral(
            od->auxTrajectoryIntegral[j],
            od->auxTrajectoryIntegralCorrection[j],
            elapsedTotal
        );
    }
    for (int j = 0; j < N_STORE_EVENTS; ++j) {
		F[ix++ * nPts + i] = od->tMaxList[j];
		F[ix++ * nPts + i] = od->xMaxList[j];
		F[ix++ * nPts + i] = od->tMinList[j];
		F[ix++ * nPts + i] = od->xMinList[j];
    }
    F[ix++ * nPts + i] = od->eventcount;
}

//Perform and post-integration cleanup of observer state to ensure it is ready for continuation if needed
static inline void finalizeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __constant realtype *tspan) {
}

#endif //USE_OBSERVER_LOCAL_MAX

#endif //OBSERVER_LOCAL_MAX_H
