// template to show function sigs, structure required for include into C++ (for baking in feature names, observer state size)

#ifndef OBSERVER_TEMPLATE_H
#define OBSERVER_TEMPLATE_H

#ifdef USE_OBSERVER_TEMPLATE //should only be defined for OpenCL preprocessor, thus not included by C++ clODE codes

struct ObserverState_template
{
    unsigned int eventcount;
    unsigned int stepcount;
};

typedef struct ObserverState_template ObserverState;

//set initial values to relevant fields in ObserverState
static inline void initializeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    od->eventcount = 0;
    od->stepcount = 0;
}

// Restricted per-timestep update for two-pass warmup collection. Only gather
// the trajectory geometry needed to initialize the live event detector.
static inline void warmupObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
}

// Process warmup data and the rewound initial live-pass sample to finalize the
// detector geometry.
static inline void initializeEventDetector(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
}

// Per-step event test on the updated history buffers. Prefer keeping the public
// event decision and any per-event interpolation geometry here or in
// computeEventFeatures instead of using updateObserverState as a proxy event
// detector.
static inline bool eventFunction(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    return false;
}

// When an event is detected, compute per-event outputs and update eventwise
// aggregates such as counts or periods. Return true on terminal-event stop.
static inline bool computeEventFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    ++od->eventcount;
    if (od->eventcount > op->maxEventCount){
        return true;
    }
    return false;
}

// Accepted-step state update before eventFunction runs. This is the place to
// advance rolling history buffers and continuous per-step reducers, not the
// primary place to decide that the observer's public event fired.
static inline void updateObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    ++od->stepcount;
}

//Perform and post-integration cleanup and write desired features into the global array F
static inline void finalizeFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __global realtype *F, int i, int nPts) {
}

//Perform and post-integration cleanup of observer state to ensure it is ready for continuation if needed
static inline void finalizeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __constant realtype *tspan) {//eg. times of last events need to be shifted left of t0
}

#endif

#endif // OBSERVER_TEMPLATE_H
