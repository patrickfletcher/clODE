

#ifndef OBSERVER_BASIC_H
#define OBSERVER_BASIC_H

#ifdef USE_OBSERVER_BASIC

struct ObserverState_basic
{
    realtype xTrajectoryMax;
    realtype xTrajectoryMin;
    realtype xTrajectoryMean;
    realtype xTrajectoryIntegral;
    realtype xTrajectoryIntegralCorrection;
    realtype dxTrajectoryMax;
    realtype dxTrajectoryMin;
    realtype elapsed_total;
    realtype elapsed_total_correction;
    unsigned int stepcount;
};
typedef struct ObserverState_basic ObserverState;

static inline void initializeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
    od->xTrajectoryMax = -BIG_REAL;
    od->xTrajectoryMin = BIG_REAL;
    od->xTrajectoryMean = ZERO;
    od->xTrajectoryIntegral = ZERO;
    od->xTrajectoryIntegralCorrection = ZERO;
    od->dxTrajectoryMax = -BIG_REAL;
    od->dxTrajectoryMin = BIG_REAL;
    od->elapsed_total = ZERO;
    od->elapsed_total_correction = ZERO;
    od->stepcount = 0;
}
//nothing to do - One pass detector
static inline void warmupObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
}

//no events
static inline void initializeEventDetector(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
}

//no events
static inline bool eventFunction(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
    return false;
}

//no events
static inline bool computeEventFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
    return false;
}

//all features are per-timestep (eventOccurred unused)
static inline void updateObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], const realtype stepDt, ObserverState *od, __constant struct ObserverParams *op) {
    ++od->stepcount;
    compensatedIntegrateConstant(
        &od->elapsed_total,
        &od->elapsed_total_correction,
        stepDt,
        ONE
    );
    realtype elapsedTotal = compensatedSumValue(
        od->elapsed_total,
        od->elapsed_total_correction
    );
    od->xTrajectoryMax = fmax(xi[op->fVarIx], od->xTrajectoryMax);
    od->xTrajectoryMin = fmin(xi[op->fVarIx], od->xTrajectoryMin);
    compensatedIntegrateConstant(
        &od->xTrajectoryIntegral,
        &od->xTrajectoryIntegralCorrection,
        stepDt,
        xi[op->fVarIx]
    );
    od->xTrajectoryMean = meanFromCompensatedIntegral(
        od->xTrajectoryIntegral,
        od->xTrajectoryIntegralCorrection,
        elapsedTotal
    );
    od->dxTrajectoryMax = fmax(dxi[op->fVarIx], od->dxTrajectoryMax);
    od->dxTrajectoryMin = fmin(dxi[op->fVarIx], od->dxTrajectoryMin);
}


static inline void finalizeFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op, __global realtype *F, const int i, const int nPts) {
    int ix = 0;
    F[ix++ * nPts + i] = od->xTrajectoryMax;
    F[ix++ * nPts + i] = od->xTrajectoryMin;
    F[ix++ * nPts + i] = od->xTrajectoryMean;
    F[ix++ * nPts + i] = od->dxTrajectoryMax;
    F[ix++ * nPts + i] = od->dxTrajectoryMin;
    F[ix++ * nPts + i] = od->stepcount;
}

//Perform and post-integration cleanup of observer state to ensure it is ready for continuation if needed
static inline void finalizeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op, __constant realtype *tspan) {
}

#endif // USE_OBSERVER_BASIC

#endif // OBSERVER_BASIC_H
