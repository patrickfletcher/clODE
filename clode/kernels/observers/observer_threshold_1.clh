// Threshold-based event detection with an absolute threshold in x[eVarIx].
// This first slice intentionally keeps one event stream and a lean readout:
// crossing timestamps plus event count, with direction chosen at runtime.

#ifndef OBSERVER_THRESHOLD_1_H
#define OBSERVER_THRESHOLD_1_H

#ifdef USE_OBSERVER_THRESHOLD_1

// Keep these numeric codes aligned with EventDirection in Python.
#define CLODE_EVENT_DIRECTION_RISING 0u
#define CLODE_EVENT_DIRECTION_FALLING 1u
#define CLODE_EVENT_DIRECTION_EITHER 2u

struct ObserverState_thresh1 {
    realtype tbuffer[2];
    realtype xbuffer[2];
#if N_STORE_EVENTS > 0
    realtype tEventList[N_STORE_EVENTS];
#endif
    unsigned int stepcount;
    unsigned int eventcount;
};

typedef struct ObserverState_thresh1 ObserverState;

//set initial values to relevant fields in ObserverState
static inline void initializeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)dxi;
    (void)auxi;
    od->tbuffer[1] = *ti;
    od->xbuffer[1] = xi[op->eVarIx];
#if N_STORE_EVENTS > 0
    for (int j = 0; j < N_STORE_EVENTS; ++j)
        od->tEventList[j] = ZERO;
#endif
    od->stepcount = 0;
    od->eventcount = 0;
}

//restricted per-timestep update of observer state for initializing event detector
static inline void warmupObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;
    (void)od;
    (void)op;
}

//process warmup data to compute relevant event detector quantities (e.g. thresholds)
static inline void initializeEventDetector(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;
    (void)od;
    (void)op;
}

static inline bool threshold1RisingCrossed(const realtype x0, const realtype x1, const realtype threshold) {
    return x0 <= threshold && x1 > threshold;
}

static inline bool threshold1FallingCrossed(const realtype x0, const realtype x1, const realtype threshold) {
    return x0 >= threshold && x1 < threshold;
}

//per-timestep check for an event.  Option: refine event (t,x,dx,aux) within the timestep with interpolation
static inline bool eventFunction(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;

    if (od->stepcount < 1)
        return false;

    const realtype threshold = op->xUpThresh;
    const realtype x0 = od->xbuffer[0];
    const realtype x1 = od->xbuffer[1];
    if (op->eventDirection == CLODE_EVENT_DIRECTION_RISING)
        return threshold1RisingCrossed(x0, x1, threshold);
    if (op->eventDirection == CLODE_EVENT_DIRECTION_FALLING)
        return threshold1FallingCrossed(x0, x1, threshold);
    return threshold1RisingCrossed(x0, x1, threshold) || threshold1FallingCrossed(x0, x1, threshold);
}

//When an event is detected, computes desired event-based features. returns true if a terminal event was reached
static inline bool computeEventFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;

    ++od->eventcount;
    realtype tThisEvent = linearInterpTimeOfValue(
        od->tbuffer[0],
        od->tbuffer[1],
        od->xbuffer[0],
        od->xbuffer[1],
        op->xUpThresh
    );

#if N_STORE_EVENTS > 0
    if (od->eventcount <= N_STORE_EVENTS)
        od->tEventList[od->eventcount - 1] = tThisEvent;
#endif

    return od->eventcount == op->maxEventCount;
}

//full per-timestep update of observer state. If an event occurred this timestep, event-based observer state is reset. Per-timestep features are computed here.
static inline void updateObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], const realtype stepDt, ObserverState *od, __constant struct ObserverRuntimeSettings *op) {
    (void)dxi;
    (void)auxi;
    (void)stepDt;
    ++od->stepcount;
    od->tbuffer[0] = od->tbuffer[1];
    od->tbuffer[1] = *ti;
    od->xbuffer[0] = od->xbuffer[1];
    od->xbuffer[1] = xi[op->eVarIx];
}

//Perform and post-integration cleanup and write desired features into the global array F
static inline void finalizeFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __global realtype *F, int i, int nPts) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;
    (void)op;

    int ix = 0;
#if N_STORE_EVENTS > 0
    for (int j = 0; j < N_STORE_EVENTS; ++j)
        F[ix++ * nPts + i] = od->tEventList[j];
#endif
    F[ix++ * nPts + i] = (realtype)od->eventcount;
}

//Perform and post-integration cleanup of observer state to ensure it is ready for continuation if needed
static inline void finalizeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverRuntimeSettings *op, __constant realtype *tspan) {
    (void)ti;
    (void)xi;
    (void)dxi;
    (void)auxi;
    (void)od;
    (void)op;
    (void)tspan;
}

#endif // USE_OBSERVER_THRESHOLD_1
#endif // OBSERVER_THRESHOLD_1_H
