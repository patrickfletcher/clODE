

#ifndef OBSERVER_BASIC_ALLVAR_H
#define OBSERVER_BASIC_ALLVAR_H

#ifdef USE_OBSERVER_BASIC_ALLVAR

struct ObserverState_basicAll
{
    realtype xTrajectoryMax[N_VAR];
    realtype xTrajectoryMin[N_VAR];
    realtype xTrajectoryMean[N_VAR];
    realtype xTrajectoryIntegral[N_VAR];
    realtype xTrajectoryIntegralCorrection[N_VAR];
    realtype dxTrajectoryMax[N_VAR];
    realtype dxTrajectoryMin[N_VAR];
    realtype auxTrajectoryMax[N_AUX];
    realtype auxTrajectoryMin[N_AUX];
    realtype auxTrajectoryMean[N_AUX];
    realtype auxTrajectoryIntegral[N_AUX];
    realtype auxTrajectoryIntegralCorrection[N_AUX];
    realtype t_last;
    realtype t_start;
    unsigned int stepcount;
};

typedef struct ObserverState_basicAll ObserverState;

static inline void initializeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
    for (int j = 0; j < N_VAR; ++j) {
        od->xTrajectoryMax[j] = -BIG_REAL;
        od->xTrajectoryMin[j] = BIG_REAL;
        od->xTrajectoryMean[j] = ZERO;
        od->xTrajectoryIntegral[j] = ZERO;
        od->xTrajectoryIntegralCorrection[j] = ZERO;
        od->dxTrajectoryMax[j] = -BIG_REAL;
        od->dxTrajectoryMin[j] = BIG_REAL;
    }
    for (int j = 0; j < N_AUX; ++j) {
        od->auxTrajectoryMax[j] = -BIG_REAL;
        od->auxTrajectoryMin[j] = BIG_REAL;
        od->auxTrajectoryMean[j] = ZERO;
        od->auxTrajectoryIntegral[j] = ZERO;
        od->auxTrajectoryIntegralCorrection[j] = ZERO;
    }
    od->t_last = *ti;
    od->t_start = *ti;
    od->stepcount = 0;
}

//nothing to do - One pass detector
static inline void warmupObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
}

//no events
static inline void initializeEventDetector(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
}

//no events
static inline bool eventFunction(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
    return false;
}

//no events
static inline bool computeEventFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
    return false;
}

//all features are per-timestep (eventOccurred unused)
static inline void updateObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op) {
    ++od->stepcount;
    realtype dt = *ti - od->t_last;
    od->t_last = *ti;
    realtype elapsedTime = *ti - od->t_start;
    for (int j = 0; j < N_VAR; ++j) {
        od->xTrajectoryMax[j] = fmax(xi[j], od->xTrajectoryMax[j]);
        od->xTrajectoryMin[j] = fmin(xi[j], od->xTrajectoryMin[j]);
        compensatedIntegrateConstant(
            &od->xTrajectoryIntegral[j],
            &od->xTrajectoryIntegralCorrection[j],
            dt,
            xi[j]
        );
        od->xTrajectoryMean[j] = meanFromCompensatedIntegral(
            od->xTrajectoryIntegral[j],
            od->xTrajectoryIntegralCorrection[j],
            elapsedTime
        );
        od->dxTrajectoryMax[j] = fmax(dxi[j], od->dxTrajectoryMax[j]);
        od->dxTrajectoryMin[j] = fmin(dxi[j], od->dxTrajectoryMin[j]);
    }
    for (int j = 0; j < N_AUX; ++j) {
        od->auxTrajectoryMax[j] = fmax(auxi[j], od->auxTrajectoryMax[j]);
        od->auxTrajectoryMin[j] = fmin(auxi[j], od->auxTrajectoryMin[j]);
        compensatedIntegrateConstant(
            &od->auxTrajectoryIntegral[j],
            &od->auxTrajectoryIntegralCorrection[j],
            dt,
            auxi[j]
        );
        od->auxTrajectoryMean[j] = meanFromCompensatedIntegral(
            od->auxTrajectoryIntegral[j],
            od->auxTrajectoryIntegralCorrection[j],
            elapsedTime
        );
    }
}


static inline void finalizeFeatures(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op, __global realtype *F, int i, int nPts) {
    int ix = 0;
    for (int j = 0; j < N_VAR; ++j) {
        F[ix++ * nPts + i] = od->xTrajectoryMax[j];
        F[ix++ * nPts + i] = od->xTrajectoryMin[j];
        F[ix++ * nPts + i] = od->xTrajectoryMean[j];
        F[ix++ * nPts + i] = od->dxTrajectoryMax[j];
        F[ix++ * nPts + i] = od->dxTrajectoryMin[j];
    }
    for (int j = 0; j < N_AUX; ++j) {
        F[ix++ * nPts + i] = od->auxTrajectoryMax[j];
        F[ix++ * nPts + i] = od->auxTrajectoryMin[j];
        F[ix++ * nPts + i] = od->auxTrajectoryMean[j];
    }
    F[ix++ * nPts + i] = od->stepcount;
}

//Perform and post-integration cleanup of observer state to ensure it is ready for continuation if needed
static inline void finalizeObserverState(realtype *ti, realtype xi[], realtype dxi[], realtype auxi[], ObserverState *od, __constant struct ObserverParams *op, __constant realtype *tspan) {
}

#endif // USE_OBSERVER_BASIC_ALLVAR

#endif // OBSERVER_BASIC_ALLVAR_H
